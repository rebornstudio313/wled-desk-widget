{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WLED Desk Widget",
  "version": "0.1.0-alpha.1",
  "identifier": "io.wleddesk.app",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WLED Desk | Widget",
        "width": 320,
        "height": 470,
        "minWidth": 308,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/app-32.png",
      "icons/app-128.png",
      "icons/app-256.png",
      "icons/app.ico"
    ],
    "targets": [
      "nsis"
    ],
    "shortDescription": "Desktop widget for WLED devices",
    "longDescription": "Local WLED control: colors, effects, presets, scenes and live LED preview.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
