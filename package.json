{
  "name": "wled-desk-widget",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/unit/*.test.mjs",
    "preview": "node scripts/server.mjs",
    "check": "node --test tests/unit/*.test.mjs && tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "test:ui": "node tests/integration/ui-smoke.mjs",
    "test:peek": "node tests/integration/peek-smoke.mjs",
    "test:scenes": "node tests/integration/scenes-smoke.mjs",
    "test:compact": "node tests/integration/compact-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "Desktop WLED controller for ESP32 and ESP8266"
}
