{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Widget LED RGB profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "devices",
    "groups",
    "scenes",
    "quickSlots",
    "ui"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "quickSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "sceneId"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "sceneId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "alwaysOnTop",
        "startOnLogin"
      ],
      "properties": {
        "locale": {
          "enum": [
            "ru",
            "en"
          ]
        },
        "alwaysOnTop": {
          "type": "boolean"
        },
        "startOnLogin": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "pattern": "^https?://"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "deviceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "deviceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "on": {
          "type": "boolean"
        },
        "brightness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "effectName": {
          "type": "string",
          "minLength": 1
        },
        "paletteName": {
          "type": "string",
          "minLength": 1
        },
        "speed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "segmentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deviceId",
            "kind",
            "presetId"
          ],
          "properties": {
            "deviceId": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "preset"
            },
            "presetId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deviceId",
            "kind",
            "state"
          ],
          "properties": {
            "deviceId": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "state"
            },
            "state": {
              "$ref": "#/$defs/state"
            }
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    }
  }
}
